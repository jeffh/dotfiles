#!/bin/bash

# Git Worktree / jj Workspace Command Runner
# Creates a temporary worktree/workspace, runs a command, and commits on success

set -euo pipefail

# Default values
COMMIT_MESSAGE=""
COMMAND_ARGS=()
BASE_BRANCH=""
KEEP_WORKTREE=false
USE_JJ=false
SETUP_COMMAND=""
BRANCH_NAME=""
WORKTREE_PATH=""
WORKSPACE_NAME=""
ORIGINAL_DIR=""

usage() {
    cat << EOF
Usage: $0 [OPTIONS] [-- COMMAND [ARGS...]]

Creates a temporary git worktree or jj workspace, runs the specified command, and
commits changes on success. Cleans up the worktree/workspace on failure.

If no command is specified, opens an interactive shell (\$SHELL).
By default, uses jj workspaces if in a jj repository, otherwise falls back to git.

OPTIONS:
    -b, --branch BRANCH      Branch/workspace name (default: auto-generated with timestamp)
    -m, --message MESSAGE    Commit/description message (default: auto-generated)
    -f, --from BRANCH        Base branch/revision to create from (default: main for git, @ for jj)
    -s, --setup COMMAND      Setup command to run after worktree creation (before main command)
    -k, --keep              Keep worktree/workspace after command execution
    -g, --git               Force git worktree usage even in jj repositories
    -h, --help              Show this help message

EXAMPLES:
    $0                              # Open interactive shell in workspace
    $0 -- npm test
    $0 -b feature-test -m "Add new tests" -- make test
    $0 -f develop -- python run_checks.py
    $0 -s "npm install" -- npm test  # Run setup before main command
    $0 --git -- npm test             # Force git worktree usage
    $0 -- claude "/do something"

Use '--' before commands with arguments to ensure proper parsing.
EOF
}

# Word list for random branch names
BRANCH_WORDS=(
    cakes apple bread candy chips coral cream daisy delta ember
    fable flame frost grape honey ivory jelly knots lemon lunar
    maple marsh melon mints oasis olive paper peach pearl piano
    plums prism quilt raven ridge river rocky roses rusty sails
    sands scout shade shelf silky solar spark spice stone storm
    sunny swirl tango toast tulip twist umbra vapor velvet waves
    wheel winds winter woods yarn zebra amber badge baker banks
    beach bells berry birds bloom books boots brain brave brick
    brush cabin cable camel candy cards cargo cedar chain chair
    chalk charm chess child chips chord clean cliff climb clock
    cloud coach coast coins coral couch craft crane crisp crown
    dairy dance darts decks delta diary disco docks dodge dolls
    doors draft drain dream dress drift drip drums dusty eagle
    edges eight elbow ember entry equal event extra faint fairy
    fancy farms feast fiber field fifty final flame flask flint
    float flock floor fluid flute focus foggy fonts force forge
    forms forum frame fresh frost fruit funds games gates gauge
    gears ghost giant gifts gills glass globe gloss goats grain
    grand grass grays green grids grove guard guide gummy gusts
)

generate_branch_name() {
    local word="${BRANCH_WORDS[$RANDOM % ${#BRANCH_WORDS[@]}]}"
    local hex
    hex=$(printf '%04x' $((RANDOM % 65536)))
    echo "${word}-${hex}"
}

cleanup() {
    local exit_code=$?

    # Nothing to clean up if path is empty or doesn't exist
    [[ -z "$WORKTREE_PATH" || ! -d "$WORKTREE_PATH" ]] && exit $exit_code

    if [[ "$KEEP_WORKTREE" == true ]]; then
        echo "Keeping workspace as requested: $WORKTREE_PATH"
        exit $exit_code
    fi

    echo "Cleaning up workspace: $WORKTREE_PATH"
    cd "$ORIGINAL_DIR"

    if [[ "$USE_JJ" == true ]]; then
        jj workspace forget "$WORKSPACE_NAME" 2>/dev/null || true
        rm -rf "$WORKTREE_PATH" 2>/dev/null || true
    else
        git worktree remove --force "$WORKTREE_PATH" 2>/dev/null || true
        # Remove branch on failure
        if [[ $exit_code -ne 0 && -n "$BRANCH_NAME" ]]; then
            echo "Removing branch due to failure: $BRANCH_NAME"
            git branch -D "$BRANCH_NAME" 2>/dev/null || true
        fi
    fi

    exit $exit_code
}

# Parse command line arguments
FORCE_GIT=false
while [[ $# -gt 0 ]]; do
    case $1 in
        -b|--branch)  BRANCH_NAME="$2"; shift 2 ;;
        -m|--message) COMMIT_MESSAGE="$2"; shift 2 ;;
        -f|--from)    BASE_BRANCH="$2"; shift 2 ;;
        -s|--setup)   SETUP_COMMAND="$2"; shift 2 ;;
        -k|--keep)    KEEP_WORKTREE=true; shift ;;
        -g|--git)     FORCE_GIT=true; shift ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; COMMAND_ARGS=("$@"); break ;;
        *)
            echo "Error: Unknown option $1" >&2
            echo "Use --help for usage information" >&2
            exit 1
            ;;
    esac
done

# Default to user's shell if no command specified
[[ ${#COMMAND_ARGS[@]} -eq 0 ]] && COMMAND_ARGS=("${SHELL:-/bin/bash}")

# Detect VCS: use jj if available and in jj repo, unless git forced
if [[ "$FORCE_GIT" != true ]] && command -v jj &>/dev/null && jj root &>/dev/null; then
    USE_JJ=true
fi

# Set defaults based on VCS
if [[ "$USE_JJ" == true ]]; then
    [[ -z "$BASE_BRANCH" ]] && BASE_BRANCH="@"
else
    [[ -z "$BASE_BRANCH" ]] && BASE_BRANCH="main"
    if ! git rev-parse --git-dir &>/dev/null; then
        echo "Error: Not in a git repository" >&2
        exit 1
    fi
fi

ORIGINAL_DIR="$(pwd)"
trap cleanup EXIT INT TERM

# Generate defaults
[[ -z "$BRANCH_NAME" ]] && BRANCH_NAME=$(generate_branch_name)
[[ -z "$COMMIT_MESSAGE" ]] && COMMIT_MESSAGE="Automated commit: ${COMMAND_ARGS[*]} ($(date '+%Y-%m-%d %H:%M:%S'))"

# Get repository name and create worktree path
if [[ "$USE_JJ" == true ]]; then
    REPO_NAME=$(basename "$(jj root)")
    WORKSPACE_NAME="$BRANCH_NAME"
else
    REPO_NAME=$(basename "$(git rev-parse --show-toplevel)")
fi

# Create temp path (jj needs empty path, git uses directory)
WORKTREE_PATH=$(mktemp -d "${TMPDIR:-/tmp}/${REPO_NAME}-XXXXXXXXXX")
[[ "$USE_JJ" == true ]] && rmdir "$WORKTREE_PATH"

if [[ "$USE_JJ" == true ]]; then
    echo "Creating jj workspace '$BRANCH_NAME' at: $WORKTREE_PATH"
    echo "Base revision: $BASE_BRANCH"
else
    echo "Creating git worktree '$BRANCH_NAME' at: $WORKTREE_PATH"
    echo "Base branch: $BASE_BRANCH"
fi
echo "Command to run: ${COMMAND_ARGS[*]}"
echo

# Create workspace/worktree
if [[ "$USE_JJ" == true ]]; then
    if ! jj workspace add "$WORKTREE_PATH" --name "$WORKSPACE_NAME" -r "$BASE_BRANCH"; then
        echo "Error: Failed to create jj workspace" >&2
        exit 1
    fi
else
    if ! git worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH" "$BASE_BRANCH"; then
        echo "Error: Failed to create git worktree" >&2
        exit 1
    fi
fi

cd "$WORKTREE_PATH"
echo "Workspace directory: $(pwd)"

# Run setup command if provided
if [[ -n "$SETUP_COMMAND" ]]; then
    echo "Running setup command: $SETUP_COMMAND"
    echo
    if ! eval "$SETUP_COMMAND"; then
        echo "Error: Setup command failed" >&2
        exit 1
    fi
    echo
    echo "Setup completed successfully."
    echo
fi

# Run the main command
if ! "${COMMAND_ARGS[@]}"; then
    echo
    echo "Command failed! Cleaning up..."
    exit 1
fi

echo
echo "Command succeeded!"

# Handle changes based on VCS
if [[ "$USE_JJ" == true ]]; then
    if jj diff --summary | grep -q .; then
        echo "Changes detected."
        echo "Change ID: $(jj log -r @ --no-graph -T 'change_id' | head -1)"
    else
        echo "No changes detected. Abandoning commit..."
        jj abandon
    fi
else
    if git diff --quiet && git diff --cached --quiet; then
        echo "No changes detected. Nothing to commit."
    else
        echo "Changes detected. Creating commit..."
        git add -A
        git commit -m "$COMMIT_MESSAGE"
        echo "Commit created successfully on branch '$BRANCH_NAME'"
        echo "Commit hash: $(git rev-parse HEAD)"
    fi
fi

cd "$ORIGINAL_DIR"

# Clean up workspace (success path)
if [[ "$KEEP_WORKTREE" == true ]]; then
    echo "Workspace preserved at: $WORKTREE_PATH"
    echo "To switch to this workspace: cd $WORKTREE_PATH"
else
    if [[ "$USE_JJ" == true ]]; then
        echo "Cleaning up jj workspace (change remains in repo)..."
        jj workspace forget "$WORKSPACE_NAME"
        rm -rf "$WORKTREE_PATH"
    else
        echo "Cleaning up git worktree (keeping branch)..."
        git worktree remove "$WORKTREE_PATH"
    fi
fi
# Clear path to prevent duplicate cleanup in trap
WORKTREE_PATH=""

if [[ "$USE_JJ" == true ]]; then
    echo "Success! Workspace '$WORKSPACE_NAME' changes committed to repo."
else
    echo "Success! Branch '$BRANCH_NAME' contains the committed changes."
fi
